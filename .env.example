# SMTP configuration for booking request emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=community@centre.org
BOOKING_RECIPIENT=community@centre.org

# Staff login credentials (server-side)
STAFF_USERNAME=staff
STAFF_PASSWORD=change-this-to-a-strong-password

# Session signing secret (set to a long random value)
SESSION_SECRET=replace-with-a-long-random-secret
